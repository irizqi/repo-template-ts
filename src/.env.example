APP_URL=http://localhost:3000

# Client app OIDC client config. Client reads these and talks to apps/auth-service.
AUTH_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars
AUTH_ISSUER=http://localhost:3001
AUTH_CLIENT_ID=core-client
AUTH_REDIRECT_URI=http://localhost:3000/auth/callback
AUTH_POST_LOGOUT_REDIRECT_URI=http://localhost:3000
AUTH_SCOPE=openid profile email offline_access role
AUTH_TOKEN_ENDPOINT_AUTH_METHOD=private_key_jwt
AUTH_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-core-client-private-key\n-----END PRIVATE KEY-----"
AUTH_PRIVATE_KEY_ALG=RS256
AUTH_PRIVATE_KEY_ID=core-client-key

# Auth service runtime config.
NODE_ENV=development
PORT=3001
AUTH_HOME_URL=http://localhost:3000
AUTH_BASE_URL=http://localhost:3001
AUTH_ADMIN_TOKEN=replace-with-a-long-random-admin-token
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
DATABASE_URL=postgres://postgres:postgres@localhost:5432/auth_service

# Auth service OIDC provider config.
OIDC_ISSUER=http://localhost:3001
OIDC_CLIENT_ID=core-client
OIDC_REDIRECT_URIS=http://localhost:3000/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URIS=http://localhost:3000
OIDC_CLIENT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nreplace-with-core-client-public-key\n-----END PUBLIC KEY-----"
OIDC_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-auth-service-signing-private-key\n-----END PRIVATE KEY-----"
OIDC_PRIVATE_KEY_ALG=RS256
OIDC_PRIVATE_KEY_ID=auth-service-key
OIDC_ACCESS_TOKEN_TTL_SECONDS=900
OIDC_REFRESH_TOKEN_TTL_SECONDS=2592000

# Password reset and OTP
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600
OTP_TTL_SECONDS=300
OTP_LENGTH=6

# core-api notification webhook. core-api owns the templates and sends signup, password reset and OTP emails.
# CORE_NOTIFICATION_TOKEN must equal NOTIFICATION_WEBHOOK_TOKEN in core-api.
CORE_NOTIFICATION_URL=http://localhost:8000/api/v1/internal/notification
CORE_NOTIFICATION_TOKEN=
